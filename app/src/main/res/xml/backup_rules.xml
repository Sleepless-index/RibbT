<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Sign-in cookies and the server's working files never go into a backup. -->
<full-backup-content>
    <exclude domain="file" path="server/cookies.txt" />
    <exclude domain="file" path="server/tmp" />
    <exclude domain="file" path="server/ytdlp" />
</full-backup-content>
