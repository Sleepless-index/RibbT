<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same exclusions for cloud backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="server/cookies.txt" />
        <exclude domain="file" path="server/tmp" />
        <exclude domain="file" path="server/ytdlp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="server/cookies.txt" />
        <exclude domain="file" path="server/tmp" />
        <exclude domain="file" path="server/ytdlp" />
    </device-transfer>
</data-extraction-rules>
